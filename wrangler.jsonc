{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crop-rotation-explorer",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-13",
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only /api/* runs the Worker; every other path is served straight from the static files.
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // Groq production model, Apache-2.0 licensed weights. Change here (not in code) if Groq retires it.
    "GROQ_MODEL": "openai/gpt-oss-20b"
  },
  "ratelimits": [
    // Per visitor IP: at most 8 assistant requests a minute. The Groq key itself is a secret (see README), never in this file.
    { "name": "ASSIST_LIMIT", "namespace_id": "1001", "simple": { "limit": 8, "period": 60 } }
  ]
}
